<Window x:Class="AРМ_Библиотекаря.BookIsuance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="Выдача книги" Height="850" Width="1500" FontFamily="Times New Roman" FontSize="16" WindowStartupLocation="CenterScreen" MinWidth="1025" MinHeight="750">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="21.5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Выдача книги" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0" FontSize="28" Width="1169" TextAlignment="Center" Foreground="#FF566C80"/>

                <Grid Grid.Row="1" Height="557" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1165">
                    <Grid HorizontalAlignment="Left" Height="420" Margin="41,38,0,0" VerticalAlignment="Top" Width="610" Background="#FFE0E7EF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Background="#FF97A8D4" >
                            <Label Grid.Column="0" Content="Книга" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF081521">
                                <Label.LayoutTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="90" />
                                        <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                    </TransformGroup>
                                </Label.LayoutTransform>
                            </Label>
                        </Grid>

                        <TextBlock x:Name="tbBookNumber" Grid.Column="1" HorizontalAlignment="Left" Margin="31,17,0,0" TextWrapping="Wrap" Text="Инвентарный номер" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="193"/>
                        <TextBox x:Name="tbxBookNumber" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="31,43,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="156" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <TextBlock x:Name="tbBookName" Grid.Column="1"  HorizontalAlignment="Left" Margin="31,70,0,0" TextWrapping="Wrap" Text="Наименование экземпляра" VerticalAlignment="Top" Foreground="#FF566C80" FontSize="18" Height="21" Width="209"/>
                        <TextBlock x:Name="tbAuthor" Grid.Column="1" HorizontalAlignment="Left" Margin="31,123,0,0" TextWrapping="Wrap" Text="Автор" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="47"/>
                        <TextBlock x:Name="tbNamePublishing" Grid.Column="1" HorizontalAlignment="Left" Margin="31,239,0,0" TextWrapping="Wrap" Text="Наименование издания" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="178"/>
                        <TextBlock x:Name="tbYearPublishing" Grid.Column="1" HorizontalAlignment="Left" Margin="33,301,0,0" TextWrapping="Wrap" Text="Год издания" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" RenderTransformOrigin="0.869,0.762" Height="21" Width="107"/>
                        <TextBox x:Name="tbxBookGenres" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="31,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="422" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <TextBlock x:Name="tbAgeLimit" Grid.Column="1" HorizontalAlignment="Left" Margin="31,354,0,0" TextWrapping="Wrap" Text="Возрастное ограничение" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" RenderTransformOrigin="0.787,6.619" Width="191" Height="21"/>
                        <TextBox x:Name="tbxAgeLimit" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="33,380,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" BorderBrush="#FF081521" Cursor="Arrow"/>



                        <TextBlock x:Name="tbGenres" Grid.Column="1" HorizontalAlignment="Left" Margin="31,176,0,0" TextWrapping="Wrap" Text="Жанры" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="59"/>
                        <TextBox x:Name="tbxBookName" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="31,96,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="422" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <TextBox x:Name="tbxAuthor" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="31,149,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="422" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <TextBox x:Name="tbxNamePublishing" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="31,265,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="422" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <TextBox x:Name="tbxYearPublishing" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="31,327,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" BorderBrush="#FF081521" Cursor="Arrow"/>

                    </Grid>
                    <TextBlock HorizontalAlignment="Left" Margin="746,298,0,0" TextWrapping="Wrap" Text="Дата выдачи" VerticalAlignment="Top" FontSize="24"/>
                    <Grid Height="244" Margin="683,38,0,0" VerticalAlignment="Top" Background="#FFE0E7EF" HorizontalAlignment="Left" Width="461">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Background="#FF97A8D4" >
                            <Label Grid.Column="0" Content="Читатель" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF081521">
                                <Label.LayoutTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="90" />
                                        <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                    </TransformGroup>
                                </Label.LayoutTransform>
                            </Label>
                        </Grid>
                        <TextBlock x:Name="tbNumberCard" Grid.Column="1" HorizontalAlignment="Left" Margin="30,10,0,0" TextWrapping="Wrap" Text="№ читательской карточки" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="236"/>
                        <TextBlock x:Name="tbSnpReader" Grid.Column="1" HorizontalAlignment="Left" Margin="30,63,0,0" TextWrapping="Wrap" Text="ФИО читателя" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="193"/>
                        <TextBox x:Name="tbxNumberCard" Grid.Column="1" TabIndex="0" HorizontalAlignment="Left" Height="22" Margin="30,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="193" BorderBrush="#FF081521" Cursor="Arrow" TextChanged="tbxNumberCard_TextChanged"/>
                        <TextBox x:Name="tbxNameReader" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="30,89,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="318" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <TextBlock x:Name="tbPhoneNumber" Grid.Column="1" HorizontalAlignment="Left" Margin="30,116,0,0" TextWrapping="Wrap" Text="Номер телефона" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="193"/>
                        <TextBox x:Name="tbxPhoneNumber" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="30,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="318" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <TextBlock x:Name="tbReaderAge" Grid.Column="1" HorizontalAlignment="Left" Margin="30,169,0,0" TextWrapping="Wrap" Text="Возраст" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="193"/>
                        <TextBox x:Name="tbxReaderAge" IsReadOnly="True" Grid.Column="1" HorizontalAlignment="Left" Height="22" Margin="30,195,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="318" BorderBrush="#FF081521" Cursor="Arrow"/>
                        <Button x:Name="btnUploadReader" TabIndex="1" Grid.Column="1" ToolTip="Заполнить поля" HorizontalAlignment="Left" Margin="243,36,0,0" VerticalAlignment="Top" Width="23" BorderBrush="#FF081521" Foreground="#FF081521" Background="#FFD9E3FF" Height="22" RenderTransformOrigin="-0.96,0.5" Click="btnUploadReader_Click">
                            <Image Source="/Resourcers\upload.png" Height="15" Width="15"/>
                        </Button>
                    </Grid>
                    <TextBlock HorizontalAlignment="Left" Margin="947,298,0,0" TextWrapping="Wrap" Text="Дата сдачи" VerticalAlignment="Top" FontSize="24"/>
                    <Calendar x:Name="cndIssue" HorizontalAlignment="Left" Margin="746,331,0,0" VerticalAlignment="Top" IsEnabled="False"/>
                    <Calendar x:Name="cndPass" Margin="947,331,35,0" VerticalAlignment="Top" IsEnabled="False"/>
                    <Button x:Name="btnIssuedBook" TabIndex="2" Margin="856,518,123,19" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" Content="Выдать книгу" Click="btnIssuedBook_Click"/>
                </Grid>
            </Grid>
            <Button x:Name="btnCancel" FontFamily="Times New Roman" FontSize="16" TabIndex="4" HorizontalAlignment="Right" Margin="0,10,23,70" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Content="Назад в библиотечный фонд" IsCancel="True" Click="btnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
