<Window x:Class="AРМ_Библиотекаря.DecommissionBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="Списание книги" Height="708" Width="1178" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="16" MinWidth="1025" MinHeight="580">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbDebtorsList" Grid.Row="0" Text="Списание книги" FontSize="28" Foreground="#FF566C80" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid Grid.Row="1" Width="900" Height="300"  HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFE0E7EF">
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Укажите причину списания (необязательно)" VerticalAlignment="Top" Foreground="#FF566C80" FontSize="20" Margin="484,10,0,0" />
                    <TextBox x:Name="tbxCause" HorizontalAlignment="Left" Height="176" Margin="484,38,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="375" TabIndex="0" BorderBrush="#FF081521" TextChanged="tbxCause_TextChanged"/>
                    <TextBlock HorizontalAlignment="Left" Margin="31,17,0,0" TextWrapping="Wrap" Text="Инвентарный номер" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80"/>
                    <TextBox x:Name="tbxNumber" HorizontalAlignment="Left" Height="22" Margin="31,43,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="156" BorderBrush="#FF081521" IsEnabled="False"/>
                    <TextBlock HorizontalAlignment="Left" Margin="31,70,0,0" TextWrapping="Wrap" Text="Наименование экземпляра" VerticalAlignment="Top" Foreground="#FF566C80" FontSize="18"/>
                    <TextBox x:Name="tbxName" HorizontalAlignment="Left" Height="22" Margin="31,96,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="304" BorderBrush="#FF081521" IsEnabled="False"/>
                    <TextBlock HorizontalAlignment="Left" Margin="31,123,0,0" TextWrapping="Wrap" Text="Автор" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80"/>
                    <TextBox x:Name="tbxAuthor" HorizontalAlignment="Left" Height="22" Margin="31,149,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="304" BorderBrush="#FF081521" IsEnabled="False"/>
                    <TextBlock HorizontalAlignment="Left" Margin="31,176,0,0" TextWrapping="Wrap" Text="Наименование издания" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80"/>
                    <TextBox x:Name="tbxPublishing" HorizontalAlignment="Left" Height="22" Margin="31,202,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="259" BorderBrush="#FF081521" IsEnabled="False"/>
                    <TextBlock HorizontalAlignment="Left" Margin="300,177,0,0" TextWrapping="Wrap" Text="Год издания" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" RenderTransformOrigin="0.641,0.773"/>
                    <TextBox x:Name="tbxYear" HorizontalAlignment="Left" Height="22" Margin="300,203,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="108" BorderBrush="#FF081521" IsEnabled="False" RenderTransformOrigin="0.444,0.455"/>
                    <TextBlock HorizontalAlignment="Left" Margin="31,229,0,0" TextWrapping="Wrap" Text="Количество страниц" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" RenderTransformOrigin="0.787,6.619"/>
                    <TextBox x:Name="tbxCount" HorizontalAlignment="Left" Height="22" Margin="31,255,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="156" BorderBrush="#FF081521" IsEnabled="False"/>
                    <TextBlock HorizontalAlignment="Left" Margin="217,229,0,0" TextWrapping="Wrap" Text="Возрастное ограничение" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" RenderTransformOrigin="0.787,6.619" Width="191"/>
                    <TextBox x:Name="tbxAge" HorizontalAlignment="Left" Height="22" Margin="217,255,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="191" BorderBrush="#FF081521" IsEnabled="False"/>
                    <Button x:Name="btnIssueBook" Height="27" Margin="526,250,72,0" FontFamily="Times New Roman" FontSize="14" TabIndex="1" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" Content="Списать книгу" RenderTransformOrigin="0.499,1.05" VerticalAlignment="Top" Click="btnIssueBook_Click"/>
                </Grid>

            </Grid>
            <Button x:Name="btnCancel" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Right" TabIndex="3" Margin="0,10,23,70" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Content="Назад в библиотечный фонд" Click="btnCancel_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
