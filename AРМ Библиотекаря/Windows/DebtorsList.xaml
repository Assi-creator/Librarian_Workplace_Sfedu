<Window x:Class="AРМ_Библиотекаря.DebtorsList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="Звдолжники библиотеки" Height="850" Width="1500" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="16" WindowState="Maximized" MinWidth="1026" MinHeight="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbDebtorsList" Grid.Row="0" Text="Задолжники библиотеки" FontSize="28" Foreground="#FF566C80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0"/>
                <DataGrid x:Name="dtgDebtorsList" Grid.Row="1" Margin="10" AutoGenerateColumns="False" CanUserResizeRows="False" CanUserAddRows="False" CanUserReorderColumns="False">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="miCloseDebtors" Header="Закрыть задолжность" Click="miCloseDebtors_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Resourcers\remove-user.png"></Image>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="miCraeteDoc" Header="Сформировать">
                                <MenuItem.Icon>
                                    <Image Source="/Resourcers\add-documents.png"></Image>
                                </MenuItem.Icon>
                                <MenuItem x:Name="miCreateWord" Header="Извещение Word (PDF)" Click="miCreateWord_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Resourcers\word.png"></Image>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="miCreateExcel" Header="Вся таблица Excel (CVS)" Click="miCreateExcel_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Resourcers\excel.png"></Image>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="miPrint" Header="Распечатать">
                                <MenuItem.Icon>
                                    <Image Source="/Resourcers\printer.png"></Image>
                                </MenuItem.Icon>
                                <MenuItem x:Name="miPrintWord" Header="Извещение Word" Click="miPrintWord_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Resourcers\word.png"></Image>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ карточки" Width="140" MinWidth="140" MaxWidth="140" IsReadOnly="True" Binding="{Binding NumberReaderCard}"/>
                        <DataGridTextColumn Header="ФИО читателя" Width="*" MinWidth="150" IsReadOnly="True" Binding="{Binding ReaderName}" />
                        <DataGridTextColumn Header="Экземпляр" Width="*" MinWidth="150" IsReadOnly="True" Binding="{Binding BookName}"/>
                        <DataGridTextColumn Header="Дата выдачи" Width="115" MinWidth="150" MaxWidth="150" IsReadOnly="True" Binding="{Binding DataIssue}"/>
                        <DataGridTextColumn Header="Дата сдачи" Width="150" MinWidth="150" MaxWidth="115" IsReadOnly="True" Binding="{Binding DataPass}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Button x:Name="btnCancel" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Right" Margin="0,10,23,70" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Content="Назад в читательские карточки" Click="btnCancel_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
