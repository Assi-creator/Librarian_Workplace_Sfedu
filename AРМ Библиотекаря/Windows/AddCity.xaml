<Window x:Class="AРМ_Библиотекаря.AddCity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="Добавить город" Height="850" Width="1500" FontFamily="Times New Roman" FontSize="16" WindowStartupLocation="CenterScreen" MinWidth="1025" MinHeight="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="200">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height ="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="tbAddCity" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Times New Roman" FontSize="26" Foreground="#FF566C80" Text="Добавление города"/>
                        <TextBlock x:Name="tbName" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF566C80" Margin="50,5,0,44" Text="Название "/>
                        <TextBox x:Name="tbxCityName" HorizontalAlignment="Left" Height="30" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Margin="50,31,0,0" TabIndex="0" TextChanged="tbxCityName_TextChanged"/>
                        <Button x:Name="btnAddCity" Content="Добавить" HorizontalAlignment="Left" Margin="50,10,0,0" VerticalAlignment="Top" Width="300" Grid.Row="4" Height="30" BorderBrush="#FF566C80" Background="#FFE0E7EF" TabIndex="1" Foreground="#FF566C80" Cursor="Hand" Click="btnAddCity_Click" IsDefault="True"/>
                    </Grid>
                </Grid>
            </Grid>
            <Button x:Name="btnCancel" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Right" Margin="0,10,23,70" Background="#FFE0E7EF" TabIndex="2" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Content="Назад в добавление издания" Click="btnCancel_Click" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
