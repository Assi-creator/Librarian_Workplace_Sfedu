<Window x:Class="AРМ_Библиотекаря.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d" Height="768" Width="1366" Title="Авторизация" MinWidth="1150" MinHeight="500" FontFamily="Times New Roman" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10"/>
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422" Text="Рабочее место библиотекаря"/>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="17"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,20,0">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="300" Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="30"/>
                        <RowDefinition/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="78"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="tbAutorization" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Times New Roman" FontSize="26" Foreground="#FF566C80">Авторизация</TextBlock>
                    <TextBlock x:Name="tbLogin" Foreground="#FF566C80" Grid.Row="1" FontSize="20" FontFamily="Times New Roman" VerticalAlignment="Bottom" Margin="50,0,0,54" Grid.RowSpan="2">Логин</TextBlock>
                    <TextBox x:Name="tbxLogin" Grid.Row="2" Width="300" Height="30" BorderBrush="#FF566C80" FontFamily="Times New Roman" FontSize="17" Foreground="#FF14212C" TabIndex="0" TextChanged="tbxLogin_TextChanged" Margin="50,13,50,14"/>
                    <TextBlock x:Name="tbPassword" Grid.Row="3" FontFamily="Times New Roman" FontSize="20" Foreground="#FF566C80" VerticalAlignment="Top" Margin="50,2,0,0" Grid.RowSpan="2">Пароль</TextBlock>
                    <TextBox x:Name="tbxPassword" Grid.Row="4" Width="300" Height="30" BorderBrush="#FF566C80" Foreground="#FF14212C" FontFamily="Times New Roman" FontSize="17" Margin="50,13,50,35"/>
                    <PasswordBox x:Name="pbxPassword" Grid.Row="4" Width="300" Height="30" BorderBrush="#FF566C80" Foreground="#FF14212C" FontFamily="Times New Roman" FontSize="17" Panel.ZIndex="1" TabIndex="1" Margin="50,13,50,35"/>
                    <Button x:Name="btnAutorization" Grid.Row="5" Width="300" Height="30" FontFamily="Times New Roman" FontSize="16" BorderBrush="#FF566C80" Background="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Click="btnAutorization_Click" TabIndex="3" Margin="50,13" IsDefault="True">Авторизация</Button>
                    <TextBlock x:Name="cbSeePassword" HorizontalAlignment="Left" Margin="80,60,0,0" VerticalAlignment="Top" Grid.Row="4" FontFamily="Times New Roman" Foreground="#FF566C80" FontSize="14" Text="Показать пароль"/>
                    <Button HorizontalAlignment="Left" Margin="50,56,0,0" Grid.Row="4" VerticalAlignment="Top" Width="25" BorderBrush="#FFA0C5EA" Background="White" Height="22" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp" TabIndex="2" Cursor="Hand">
                        <Image Source="/Resourcers\hide.png"/>
                    </Button>
                </Grid>
                <Image Source="/Resourcers\load.jpg" Margin="0,-220,0,0" Width="1315" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="None" Height="820" Grid.RowSpan="2"/>
            </Grid>
            <Button x:Name="btnHistory" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Right" Content="История входа" Margin="0,10,157,70" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Click="btnHistory_Click" TabIndex="5"/>
            <Button x:Name="btnExit" HorizontalAlignment="Right" Margin="0,10,23,70" BorderBrush="#FFE0E7EF" Content="Выход из системы" Background="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" FontFamily="Times New Roman" FontSize="16" Click="btnExit_Click" TabIndex="7" IsCancel="True"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="101" Panel.ZIndex="1" Margin="0,0,1181,0"/>
        </Grid>
    </Grid>
</Window>
