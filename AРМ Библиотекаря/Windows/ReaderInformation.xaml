<Window x:Class="AРМ_Библиотекаря.ReaderInformation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
         Title="Читательские карточки" Height="768" Width="1366" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="16" WindowState="Maximized" MinWidth="1025" MinHeight="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Grid Grid.Column="0" Grid.Row="1" Margin="10,10,0,0" Width="240" Background="#FFE0E7EF" Height="184" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="#FF97A8D4" >
                        <Label Grid.Column="0" Content="Поиск" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF081521">
                            <Label.LayoutTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="90" />
                                    <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                </TransformGroup>
                            </Label.LayoutTransform>
                        </Label>
                    </Grid>

                    <Label x:Name="lSearch" Foreground="#FF081521" Grid.Column="1" Margin="10,0,0,144" FontFamily="Times New Roman" FontSize="18" Height="30" VerticalAlignment="Bottom">Критерий поиска:</Label>
                    <RadioButton x:Name="rbNumber" Grid.Column="1" FontFamily="Times New Roman" FontSize="14" Margin="10,0,0,119" Foreground="#FF081521" BorderBrush="#FF081521" Height="20" VerticalAlignment="Bottom" TabIndex="0" Content="Номер карточки" IsChecked="True"/>
                    <RadioButton x:Name="rbName" Grid.Column="1" FontFamily="Times New Roman" FontSize="14" Margin="10,0,0,94" Foreground="#FF081521" BorderBrush="#FF081521" Height="20" VerticalAlignment="Bottom" TabIndex="1" Content="ФИО читателя"/>
                    <Label Grid.Column="1" Margin="10,0,5,50" FontFamily="Times New Roman" FontSize="14" Foreground="#FF081521" Height="44" VerticalAlignment="Bottom">Текст для поиска:</Label>
                    <TextBox x:Name="tbxSearch" Grid.Column="1" Height="20" Margin="10,0,10,50" BorderBrush="#FF081521" VerticalAlignment="Bottom" TabIndex="2" TextChanged="tbxSearch_TextChanged"/>
                    <Button x:Name="btnClearSearch" HorizontalAlignment="Left" Margin="174,10,0,0" VerticalAlignment="Top" Width="21" Grid.Column="1" Height="19" Background="#FFE0E7EF" BorderBrush="#FF081521" TabIndex="4" Cursor="Hand" ToolTip="Очистить фильтр" Click="btnClearSearch_Click">
                        <Image Source="/Resourcers\close.png" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
                    </Button>
                    <Button x:Name="btnSearch" Grid.Column="1" Height="20" Margin="10,0,10,20" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" TabIndex="3" VerticalAlignment="Bottom" Click="btnSearch_Click">Поиск</Button>
                </Grid>

                <DataGrid x:Name="dtgReader" Grid.Column="1" Grid.Row="1" Margin="10" FontFamily="Times New Roman" FontSize="14" SelectionMode="Single" IsReadOnly="True" 
                          AutoGenerateColumns="False" CanUserResizeRows="False" CanUserAddRows="False" CanUserReorderColumns="False" 
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.IsContainerVirtualizable="True"
                          VirtualizingPanel.ScrollUnit="Item" 
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserResizeColumns="False">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="miDelete" Header="Удалить" Click="miDelete_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Resourcers\remove-user.png"></Image>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ карточки" Width="140" MaxWidth="140" MinWidth="140" Binding="{Binding ReaderNumber}" IsReadOnly="True"></DataGridTextColumn>
                        <DataGridTextColumn Header="ФИО читателя" Width="*" MinWidth="150" MaxWidth="300" Binding="{Binding ReaderSNP}" IsReadOnly="True"></DataGridTextColumn>
                        <DataGridTextColumn Header="Номер телефона" Width="200" MinWidth="200" MaxWidth="200" Binding="{Binding ReaderPhone}" IsReadOnly="True"></DataGridTextColumn>
                        <DataGridTextColumn Header="Адрес" Width="*" MinWidth="300" MaxWidth="300" Binding="{Binding ReaderAddress}" IsReadOnly="True"></DataGridTextColumn>
                        <DataGridTextColumn Header="Дата рождения" Width="150" MaxWidth="150" MinWidth="150" Binding="{Binding ReaderBithdate}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Место обучения" Width="*" Binding="{Binding ReaderPlaceOfStudy}"></DataGridTextColumn>
                        <DataGridTextColumn Header="Класс" Width="115" MaxWidth="115" MinWidth="115" Binding="{Binding ReaderClass}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Column="0" Grid.Row="1" Margin="10,220,0,0" Width="240" Background="#FFE0E7EF" Height="140" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="#FF97A8D4" >
                        <Label Grid.Column="0" Content="Функции" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF081521">
                            <Label.LayoutTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="90" />
                                    <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                </TransformGroup>
                            </Label.LayoutTransform>
                        </Label>
                    </Grid>
                    <Button x:Name="btnDebtorsList" Grid.Column="1" Height="20" Margin="10,0,10,60" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand"  VerticalAlignment="Bottom" Content="Задолжники" TabIndex="7" Click="btnDebtorsList_Click"/>
                    <Button x:Name="btnRegistrated" Grid.Column="1" Height="20" Margin="10,0,10,100" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand"  VerticalAlignment="Bottom" Content="Зарегистрировать читателя" TabIndex="5" Click="btnRegistrated_Click"/>
                    <Button x:Name="btnStatistics" Grid.Column="1" Height="20" Margin="10,0,10,20" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand"  VerticalAlignment="Bottom" Content="Статистика" TabIndex="8" Click="btnStatistics_Click"/>
                </Grid>
                <TextBlock Text="Читательские карточки" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,8,10,0" FontSize="28" Width="1035" TextAlignment="Center" Foreground="#FF566C80" Grid.Column="1"/>
            </Grid>
            <Button x:Name="btnExit" HorizontalAlignment="Right" Margin="0,10,23,65" BorderBrush="#FFE0E7EF" Background="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" FontFamily="Times New Roman" FontSize="16" TabIndex="11" IsCancel="True" Click="btnExit_Click">Выход из системы</Button>
            <Button x:Name="btnCancel" HorizontalAlignment="Right" Margin="0,11,162,65" BorderBrush="#FFE0E7EF" Background="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" FontFamily="Times New Roman" FontSize="16" TabIndex="10" Click="btnCancel_Click">Назад в библиотечный фонд</Button>
        </Grid>
    </Grid>
</Window>
