<Window x:Class="AРМ_Библиотекаря.AddPublishing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="Добавить издательство" Height="850" Width="1500" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="16" MinWidth="1025" MinHeight="625">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>


            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbDebtorsList" Grid.Row="0" Text="Добавление издательства" FontSize="28" Foreground="#FF566C80" HorizontalAlignment="Center" VerticalAlignment="Center"  Width="368" TextAlignment="Center"/>

                <Grid Grid.Row="1" Background="#FFE0E7EF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="368" Height="196" Margin="0">
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="33,10,0,0" TextWrapping="Wrap" Text="Наименование издательства" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" RenderTransformOrigin="0.787,6.619" Width="252" Height="21"/>
                    <TextBox x:Name="tbxNamePublishing" Grid.Column="0" TabIndex="0" HorizontalAlignment="Left" Height="22" Margin="33,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="304" BorderBrush="#FF081521" TextChanged="tbxNamePublishing_TextChanged"/>
                    <Button x:Name="btnAddCity" Grid.Column="0" HorizontalAlignment="Left" TabIndex="2" Margin="274,106,0,0" VerticalAlignment="Top" Width="25" BorderBrush="#FF081521" Foreground="#FF081521" Background="#FFD9E3FF" Height="24" Cursor="Hand" Click="btnAddCity_Click">
                        <Image Source="/Resourcers\plus.png" Height="15" Width="15"></Image>
                    </Button>
                    <Button x:Name="btnRefreshCity" Grid.Column="0" TabIndex="3" HorizontalAlignment="Left" Margin="312,106,0,0" VerticalAlignment="Top" Width="25" BorderBrush="#FF081521" Foreground="#FF081521" Background="#FFD9E3FF" Height="24" RenderTransformOrigin="-0.96,0.5" Click="btnRefreshCity_Click" Cursor="Hand">
                        <Image Source="/Resourcers\refresh.png" Height="19" Width="19"></Image>
                    </Button>

                    <Button x:Name="btnAddPublishing"  Grid.Column="0" TabIndex="4" Content="Добавить издательство" HorizontalAlignment="Center" VerticalAlignment="Center" Width="228" Height="30" Background="#FFE0E7EF" BorderBrush="#FF081521" Foreground="#FF081521" Cursor="Hand" Margin="0,140,0,0" Click="btnAddPublishing_Click"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="33,80,0,0" TextWrapping="Wrap" Text="Город" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" RenderTransformOrigin="0.787,6.619" Width="93" Height="21"/>
                    <ComboBox x:Name="cmbCity" HorizontalAlignment="Left" TabIndex="1" Margin="33,106,0,0" VerticalAlignment="Top" Width="226">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Background="Transparent" Text="{Binding}"></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Grid>


            <Button x:Name="btnCancel" FontFamily="Times New Roman" FontSize="16" TabIndex="5" HorizontalAlignment="Right" Margin="0,10,23,70" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Content="Назад в добавление книг" IsCancel="True" Click="btnCancel_Click_1"/>
        </Grid>
        <DockPanel HorizontalAlignment="Left" Height="100" LastChildFill="False" Margin="1494,152,-102,0" Grid.Row="1" VerticalAlignment="Top" Width="100"/>
    </Grid>
</Window>
