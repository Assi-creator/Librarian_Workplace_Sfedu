<Window x:Class="AРМ_Библиотекаря.AddReaderCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="Регистрация читателя" Height="850" Width="1500" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="16" MinWidth="1025" MinHeight="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbDebtorsList" Grid.Row="0" Text="Добавление карточки читателя" FontSize="28" Foreground="#FF566C80" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4" Width="1429" TextAlignment="Center"/>

                <Grid Grid.Row="1" Background="#FFE0E7EF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="466" Height="381">
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="28,17,0,0" TextWrapping="Wrap" Text="Фамилия" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="156"/>
                    <TextBox x:Name="tbxSurname" TabIndex="0" Grid.Column="0" HorizontalAlignment="Left" Height="22" Margin="28,43,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="156" BorderBrush="#FF081521" TextChanged="tbxSurname_TextChanged"/>

                    <Button x:Name="btnAddReadingCard" TabIndex="9" Grid.Column="0" Content="Добавить читателя" HorizontalAlignment="Center" VerticalAlignment="Center" Width="228" Height="30" Background="#FFE0E7EF" BorderBrush="#FF081521" Foreground="#FF081521" Cursor="Hand" Margin="0,300,0,0" Click="btnAddReadingCard_Click"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="28,70,0,0" TextWrapping="Wrap" Text="Имя" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="156"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="28,123,0,0" TextWrapping="Wrap" Text="Отчество" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="156"/>
                    <TextBox x:Name="tbxName" TabIndex="1" Grid.Column="0" HorizontalAlignment="Left" Height="22" Margin="28,96,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="156" BorderBrush="#FF081521" TextChanged="tbxName_TextChanged"/>
                    <TextBox x:Name="tbxPatronymic" TabIndex="2" Grid.Column="0" HorizontalAlignment="Left" Height="22" Margin="28,149,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="156" BorderBrush="#FF081521" TextChanged="tbxPatronymic_TextChanged"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="246,17,0,0" TextWrapping="Wrap" Text="Номер телефона" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="193"/>
                    <TextBox x:Name="tbxPhone" TabIndex="3" Grid.Column="0" HorizontalAlignment="Left" Height="22" Margin="246,43,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="184" BorderBrush="#FF081521" TextChanged="tbxPhone_TextChanged"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="246,75,0,0" TextWrapping="Wrap" Text="Дата рождения" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="193"/>
                    <TextBox x:Name="tbxBirthday" TabIndex="4" Grid.Column="0" HorizontalAlignment="Left" Height="22" Margin="246,101,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="184" BorderBrush="#FF081521" TextChanged="tbxBirthday_TextChanged"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="246,128,0,0" TextWrapping="Wrap" Text="Адрес" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="184"/>
                    <TextBox x:Name="tbxAddress" TabIndex="5" Grid.Column="0" HorizontalAlignment="Left" Height="22" Margin="246,149,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="184" BorderBrush="#FF081521" TextChanged="tbxAddress_TextChanged"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="28,245,0,0" TextWrapping="Wrap" Text="Место учебы" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="180"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="28,176,0,0" TextWrapping="Wrap" Text="Образование" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="193"/>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="246,245,0,0" TextWrapping="Wrap" Text="Класс" VerticalAlignment="Top" FontSize="18" Foreground="#FF566C80" Height="21" Width="184"/>
                    <TextBox x:Name="tbxPlaceOfStudy" TabIndex="7" Grid.Column="0" HorizontalAlignment="Left" Height="22" Margin="28,271,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" BorderBrush="#FF081521" TextChanged="tbxPlaceOfStudy_TextChanged"/>
                    <TextBox x:Name="tbxClass" Grid.Column="0" TabIndex="8" HorizontalAlignment="Left" Height="22" Margin="246,271,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="184" BorderBrush="#FF081521" TextChanged="tbxClass_TextChanged"/>
                    <ComboBox x:Name="cmbEducation" TabIndex="6" HorizontalAlignment="Left" Margin="28,202,0,0" VerticalAlignment="Top" Width="402" SelectionChanged="cmbEducation_SelectionChanged"/>
                </Grid>
            </Grid>
            <Button x:Name="btnCancel" TabIndex="10" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Right" Margin="0,10,23,70" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" Content="Назад в читательские карточки" IsCancel="True" Click="btnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
