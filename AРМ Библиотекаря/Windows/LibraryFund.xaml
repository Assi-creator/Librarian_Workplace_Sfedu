<Window x:Class="AРМ_Библиотекаря.LibraryFund"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="Библиотечный фонд" Height="850" Width="1500" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="16" WindowState="Maximized" MinWidth="1500" MinHeight="770">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="17"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Библиотечный фонд" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Column="1" Margin="10,0" FontSize="28" Width="1169" TextAlignment="Center" Foreground="#FF566C80"/>

                <DataGrid x:Name="dtgBook" Grid.Column="1" Grid.Row="1" Margin="10,10,10,10" FontFamily="Times New Roman" FontSize="14" SelectionMode="Single" 
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeRows="False" CanUserAddRows="False" CanUserReorderColumns="False"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.IsContainerVirtualizable="True"
                          VirtualizingPanel.ScrollUnit="Item" 
                          EnableRowVirtualization="False" VirtualizingStackPanel.VirtualizationMode="Standard" EnableColumnVirtualization="True" LoadingRow="dtgBook_LoadingRow">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="miIssue" Header="Выдать книгу" Click="miIssue_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Resourcers\hand-over.png"></Image>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="miDecommission" Header="Списать книгу" Click="miDecommission_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Resourcers\book.png"></Image>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Инвентарный номер" Width="140" MinWidth="140" MaxWidth="140" IsReadOnly="True" Binding="{Binding BookNumber}"/>
                        <DataGridTextColumn Header="Наименование" Width="*" MinWidth="150" IsReadOnly="True" Binding="{Binding BookName}" />
                        <DataGridTextColumn Header="Автор" Width="*" MinWidth="150" IsReadOnly="True" Binding="{Binding BookAutor}"/>
                        <DataGridTextColumn Header="Жанр" Width="*" MinWidth="150" IsReadOnly="True" Binding="{Binding BookGenre}"/>
                        <DataGridTextColumn Header="Издательство" Width="180" MinWidth="180" MaxWidth="200" IsReadOnly="True" Binding="{Binding BookPublishing}"/>
                        <DataGridTextColumn Header="Год издательства" Width="115" MinWidth="115" MaxWidth="115" IsReadOnly="True" Binding="{Binding BookYear}"/>
                        <DataGridTextColumn Header="Количество страниц" Width="135" MinWidth="135" MaxWidth="135" IsReadOnly="True" Binding="{Binding BookPages}"/>
                        <DataGridTextColumn Header="Возрастное ограничение" Width="160" MinWidth="160" MaxWidth="160" IsReadOnly="True" Binding="{Binding BookAge}"/>
                        <DataGridTextColumn Width="1" MinWidth="1" MaxWidth="1" IsReadOnly="True" Binding="{Binding IsEnable}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Height="190" Margin="10,10,0,0" VerticalAlignment="Top" Width="240" Background="#FFE0E7EF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="#FF97A8D4" >
                        <Label Grid.Column="0" Content="Поиск" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF081521">
                            <Label.LayoutTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="90" />
                                    <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                </TransformGroup>
                            </Label.LayoutTransform>
                        </Label>
                    </Grid>

                    <Label x:Name="lSearch" Foreground="#FF081521" Grid.Column="1" Margin="10,5,0,155" FontFamily="Times New Roman" FontSize="18">Критерий поиска:</Label>
                    <RadioButton x:Name="rbNumber" Grid.Column="1" FontFamily="Times New Roman" FontSize="14" Margin="10,40,0,130" Foreground="#FF081521" BorderBrush="#FF081521" IsChecked="True" Cursor="Hand" TabIndex="0">Инвентарный номер</RadioButton>
                    <RadioButton x:Name="rbName" Grid.Column="1" FontFamily="Times New Roman" FontSize="14" Margin="10,65,0,105" Foreground="#FF081521" BorderBrush="#FF081521" Cursor="Hand" TabIndex="1">Наименование</RadioButton>
                    <RadioButton x:Name="rbAuthor" Grid.Column="1" FontFamily="Times New Roman" FontSize="14" Margin="10,90,0,85" Foreground="#FF081521" BorderBrush="#FF081521" Cursor="Hand" TabIndex="2">ФИО автора</RadioButton>
                    <Label Grid.Column="1" Margin="5,110,10,36" FontFamily="Times New Roman" FontSize="14" Foreground="#FF081521">Текст для поиска:</Label>
                    <TextBox x:Name="tbxSearch" Grid.Column="1" Height="20" Margin="10,134,10,36" BorderBrush="#FF081521" TextChanged="tbxSearch_TextChanged" TabIndex="3"/>
                    <Button x:Name="btnSearch" Grid.Column="1" Height="20" Margin="10,160,10,10" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" Click="btnSearch_Click" TabIndex="4">Поиск</Button>
                    <Button x:Name="btnClearSearch" HorizontalAlignment="Left" Margin="174,10,0,0" VerticalAlignment="Top" Width="21" Grid.Column="1" Height="19" Background="#FFE0E7EF" BorderBrush="#FF081521" Cursor="Hand" ToolTip="Очистить фильтр" TabIndex="5" Click="btnClearSearch_Click">
                        <Image Source="/Resourcers\close.png" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
                    </Button>
                </Grid>

                <Grid Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Height="104" Margin="10,219,0,0" VerticalAlignment="Top" Width="240" Background="#FFE0E7EF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Grid.Row="1" Background="#FF97A8D4" >
                        <Label Grid.Column="0" Content="Жанры" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF081521">
                            <Label.LayoutTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="90" />
                                    <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                </TransformGroup>
                            </Label.LayoutTransform>
                        </Label>
                    </Grid>

                    <Label x:Name="lSelectGenre" Grid.Column="1" FontFamily="Times New Roman" FontSize="18" Margin="10,10,10,0" Height="32" VerticalAlignment="Top" Foreground="#FF081521">Выберите жанры:</Label>
                    <ComboBox x:Name="cmbGenre" Grid.Column="1" Margin="10,47,10,0" BorderBrush="#FF081521" Height="20" TabIndex="6" VerticalAlignment="Top" SelectedIndex="0" DropDownOpened="cmbGenre_DropDownOpened" Cursor="Hand">

                        <ComboBoxItem x:Name="FirstItemField" Margin="0,0,0,-40" IsEnabled="False" Visibility="Hidden" >
                            <TextBlock Background="Transparent" Foreground="Gray" FontSize="12">Жанры</TextBlock>
                        </ComboBoxItem>

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <ComboBoxItem>
                                    <CheckBox  
                                              IsChecked="{Binding Path=IsChecked, UpdateSourceTrigger=PropertyChanged}" Content="{Binding GenreName}"/>
                                </ComboBoxItem>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="btnSearchGenre" Grid.Column="1" Height="20" Margin="10,74,10,0" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" TabIndex="7" Cursor="Hand" Click="btnSearchGenre_Click" Content="Поиск" RenderTransformOrigin="0.499,1.05" VerticalAlignment="Top"/>
                    <Button x:Name="btnClearGenreSearch" HorizontalAlignment="Left" Margin="174,10,0,0" VerticalAlignment="Top" Width="21" Grid.Column="1" Height="19" Background="#FFE0E7EF" BorderBrush="#FF081521" TabIndex="8" ToolTip="Очистить фильтр" Cursor="Hand" Click="btnClearGenreSearch_Click">
                        <Image Source="/Resourcers\close.png" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"></Image>
                    </Button>
                </Grid>

                <Grid Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" Margin="10,343,0,0" Width="240" Background="#FFE0E7EF" VerticalAlignment="Top" Height="177">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Background="#FF97A8D4" >
                        <Label Grid.Column="0" Content="Функции" HorizontalContentAlignment="Center" FontFamily="Times New Roman" FontSize="18" Foreground="#FF081521">
                            <Label.LayoutTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="90" />
                                    <ScaleTransform ScaleX="-1" ScaleY="-1"/>
                                </TransformGroup>
                            </Label.LayoutTransform>
                        </Label>
                    </Grid>
                    <Button x:Name="btnReaders" Grid.Column="1" Height="20" Margin="10,17,10,0" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" Click="btnReaders_Click" Content="Читательские карточки" TabIndex="9" VerticalAlignment="Top"/>
                    <Button x:Name="btnAddBook" Grid.Column="1" Height="20" Margin="10,57,10,0" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" Content="Добавить книгу в фонд" TabIndex="10" VerticalAlignment="Top" Click="btnAddBook_Click"/>
                    <Button x:Name="btnIssuedBooks" Grid.Column="1" Height="20" Margin="10,97,10,0" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" Click="btnIssuedBooks_Click" Content="Выданные книги" TabIndex="12" VerticalAlignment="Top"/>
                    <Button x:Name="btnStatistics" Grid.Column="1" Height="20" Margin="10,137,10,0" FontFamily="Times New Roman" FontSize="14" BorderBrush="#FF081521" Background="#FFE0E7EF" Foreground="#FF081521" Cursor="Hand" Click="btnStatistics_Click" Content="Статистика" TabIndex="13" VerticalAlignment="Top"/>
                </Grid>
            </Grid>
            <Button x:Name="btnChangeAccount" HorizontalAlignment="Right" Margin="0,10,157,65" Width="128" BorderBrush="#FFE0E7EF" Background="#FFE0E7EF" Foreground="#FF566C80" FontFamily="Times New Roman" FontSize="16" Cursor="Hand" TabIndex="15" Click="btnChangeAccount_Click">Сменить аккаунт</Button>
            <Button x:Name="btnExit" HorizontalAlignment="Right" Margin="0,10,23,65" BorderBrush="#FFE0E7EF" Background="#FFE0E7EF" Foreground="#FF566C80" Cursor="Hand" FontFamily="Times New Roman" FontSize="16" Click="btnExit_Click" TabIndex="16" IsCancel="True">Выход из системы</Button>
        </Grid>
    </Grid>
</Window>
