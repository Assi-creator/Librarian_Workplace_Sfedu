<Window x:Class="AРМ_Библиотекаря.LoginHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AРМ_Библиотекаря"
        mc:Ignorable="d"
        Title="История входа" Height="768" Width="1366" FontFamily="Times New Roman" FontSize="16" WindowStartupLocation="CenterScreen" WindowState="Maximized" MinWidth="1080" MinHeight="625">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" Width="660">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD9E2E9" Offset="0"/>
                    <GradientStop Color="#FF97A8D4" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Image x:Name="imgBookIcon" Source="/Resourcers\BookIcon.png" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="100" Margin="10 0 0 0"/>
            <Line Stroke="#FF566C80" X1="120" X2="0" Y1="100" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="120" Y1="50" Y2="100"/>
            <Line Stroke="#FF566C80" X1="170" X2="600" Y1="50" Y2="50"/>
            <Line Stroke="#FF566C80" X1="600" X2="650" Y1="50" Y2="0"/>
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="21,1,-21,-1" />
            <Polygon Fill="#FFE0E7EF" Points="50, 150, 150, 50, 250, 150" Margin="508,-56,-102,6" RenderTransformOrigin="0.554,0.458" Height="150" VerticalAlignment="Bottom" />
            <Rectangle Fill="#FFE0E7EF" Margin="171,51,-44,-10" RenderTransformOrigin="0.5,0.5" />
            <TextBlock x:Name="tbTitle" Margin="185,7,0,50" FontFamily="Times New Roman" FontSize="33" Foreground="#FF566C80" HorizontalAlignment="Left" Width="422">Рабочее место библиотекаря</TextBlock>
        </Grid>

        <Grid Background="#FFE0E7EF" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="17"></ColumnDefinition>
                </Grid.ColumnDefinitions>
            </Grid>

            <Grid Grid.Row="1" Background="White" Margin="20,0,23,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <DataGrid x:Name="dgLoginHistory" Margin="10" FontFamily="Times New Roman" FontSize="14" Grid.Row="1"  SelectionMode="Single"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.IsContainerVirtualizable="True"
                          VirtualizingPanel.ScrollUnit="Item" 
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserResizeColumns="False" TabIndex="3">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО пользователя" Width="*" Binding="{Binding userSNP}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Логин пользователя" Width="*" Binding="{Binding userLogin}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Дата входа" Width="*" Binding="{Binding userLoginDate}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="0" Text="История входа" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="28" Width="220" TextAlignment="Center" Foreground="#FF566C80"/>
            </Grid>
            <Button x:Name="btnCancel" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Right" Margin="0,10,23,70" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80" 
                    Cursor="Hand" Content="Назад в авторизацию" Click="btnCancel_Click" IsCancel="True" TabIndex="1"/>
            <Button x:Name="btnClear" FontFamily="Times New Roman" FontSize="16" HorizontalAlignment="Right" Margin="0,13,178,72" Background="#FFE0E7EF" BorderBrush="#FFE0E7EF" Foreground="#FF566C80"
                    Cursor="Hand" Content="Очистить историю" Click="btnClear_Click" TabIndex="0"/>
        </Grid>
    </Grid>
</Window>
